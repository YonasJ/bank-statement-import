<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="online_bank_statement_provider_form">
        <field name="name">online.bank.statement.provider.form</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']" position="inside">
                <group
                    name="plaid"
                    string="Plaid config"
                    invisible="service != 'plaid'"
                >
                    <field name="plaid_access_token" invisible="1" />
                    <field
                        name="username"
                        required="service == 'plaid'"
                        password="1"
                        string="Client ID"
                    />
                    <field
                        name="password"
                        required="service == 'plaid'"
                        password="1"
                        string="Secret Key"
                    />
                    <field
                        name="plaid_host"
                        required="service == 'plaid'"
                        string="Plaid Host"
                    />
                    <field
                        name="plaid_account_name"
                        invisible="not plaid_account_name"
                    />
                    <field
                        name="plaid_account_mask"
                        invisible="not plaid_account_mask"
                    />
                    <field
                        name="plaid_account_currency"
                        invisible="not plaid_account_currency"
                    />
                    <field
                        name="plaid_account_id"
                        invisible="not plaid_account_id"
                    />
                </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    type="object"
                    class="btn btn-secondary"
                    name="action_sync_with_plaid"
                    string="Sync with Plaid.com"
                    invisible="service != 'plaid'"
                />
                <button
                    type="object"
                    class="btn btn-secondary"
                    name="action_select_plaid_account"
                    string="Select Plaid Account"
                    invisible="service != 'plaid' or not plaid_access_token"
                />
                <button
                    type="object"
                    class="btn btn-secondary"
                    name="action_link_existing_plaid"
                    string="Link Existing Plaid Connection"
                    invisible="service != 'plaid' or plaid_access_token"
                />
            </xpath>
        </field>
    </record>
</odoo>
