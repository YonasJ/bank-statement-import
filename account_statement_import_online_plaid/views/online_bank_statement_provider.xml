<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="online_bank_statement_provider_form">
        <field name="name">online.bank.statement.provider.form</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']" position="inside">
                <group
                    name="plaid"
                    string="Plaid config"
                    invisible="service != 'plaid'"
                >
                    <field
                        name="plaid_bank_account_id"
                        string="Plaid Account"
                        options="{'no_create': True}"
                    />
                    <field name="plaid_connection_id" invisible="1" />
                    <field name="plaid_account_id" invisible="1" />
                    <field name="plaid_account_name" invisible="1" />
                    <field name="plaid_account_mask" invisible="1" />
                    <field name="plaid_account_currency" invisible="1" />
                    <field name="plaid_access_token" invisible="1" />
                    <field name="username" invisible="1" />
                    <field name="password" invisible="1" />
                    <field name="plaid_host" invisible="1" />
                </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    type="action"
                    class="btn btn-secondary"
                    name="%(action_plaid_bank_connection)d"
                    string="Plaid Bank Connections"
                    invisible="service != 'plaid'"
                />
            </xpath>
        </field>
    </record>
</odoo>
