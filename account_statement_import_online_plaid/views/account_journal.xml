<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form_inherit_plaid" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.plaid</field>
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.view_account_journal_form"
        />
        <field name="arch" type="xml">
            <!-- Hide the Configuration button when provider is Plaid -->
            <xpath
                expr="//button[@name='action_open_online_bank_statement_provider']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >online_bank_statement_provider == 'plaid' or not online_bank_statement_provider_id</attribute>
            </xpath>

            <!-- Add Plaid tab after Advanced Settings -->
            <xpath
                expr="//notebook//page[@name='advanced_settings']"
                position="after"
            >
                <page
                    name="plaid_settings"
                    string="Plaid"
                    invisible="bank_statements_source != 'online' or online_bank_statement_provider != 'plaid'"
                >
                    <group name="plaid_main">
                        <group name="plaid_account_group" string="Plaid Account">
                            <field
                                name="plaid_bank_account_id"
                                string="Plaid Account"
                                options="{'no_create': True}"
                            />
                            <div colspan="2">
                                <button
                                    name="%(account_statement_import_online_plaid.action_plaid_bank_connection)d"
                                    type="action"
                                    string="Plaid Bank Connections"
                                    class="btn btn-secondary mt8"
                                    icon="fa-university"
                                />
                            </div>
                        </group>
                        <group name="plaid_pull_schedule" string="Scheduled Pull">
                            <label
                                for="plaid_interval_number"
                                string="Scheduled update interval"
                            />
                            <div class="o_row" id="plaid_interval_number">
                                <field name="plaid_interval_number" class="ml8" />
                                <field name="plaid_interval_type" />
                            </div>
                            <field
                                name="plaid_next_run"
                                string="Next scheduled pull"
                            />
                        </group>
                        <group
                            name="plaid_statement_config"
                            string="Statement Configuration"
                        >
                            <field
                                name="plaid_statement_creation_mode"
                                string="Transactions interval to obtain"
                            />
                            <field
                                name="plaid_create_statement"
                                string="Create Statement?"
                            />
                            <field name="plaid_tz" string="Timezone" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
